{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gimpro.local/schema/exercise-catalog-v1.json",
  "title": "Gimpro exercise catalog",
  "type": "object",
  "required": ["catalog_version", "taxonomy_version", "exercises"],
  "additionalProperties": false,
  "properties": {
    "catalog_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "taxonomy_version": { "const": "taxonomy-v0.1" },
    "exercises": {
      "type": "array",
      "minItems": 20,
      "items": { "$ref": "#/$defs/exercise" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "progressionStep": {
      "type": "object",
      "required": ["id", "label", "difficulty", "changes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "evaluationCriterion": {
      "type": "object",
      "required": ["id", "question"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "question": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "motorPolicy": {
      "type": "object",
      "required": ["accepted_types", "rarity", "refreshable"],
      "additionalProperties": false,
      "properties": {
        "accepted_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["title", "phrase", "place", "character", "situation", "relationship", "word", "object"]
          }
        },
        "rarity": {
          "type": "array",
          "prefixItems": [
            { "type": "integer", "minimum": 0, "maximum": 4 },
            { "type": "integer", "minimum": 0, "maximum": 4 }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "refreshable": { "const": true }
      }
    },
    "source": {
      "type": "object",
      "required": ["source_type", "adaptation_notes", "reviewed_at"],
      "additionalProperties": false,
      "properties": {
        "source_type": {
          "enum": ["original", "adaptation", "tradition", "public_domain", "reference"]
        },
        "title": { "type": ["string", "null"] },
        "author": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"] },
        "license": { "type": ["string", "null"] },
        "adaptation_notes": { "$ref": "#/$defs/nonEmptyString" },
        "reviewed_at": { "type": "string", "format": "date" }
      }
    },
    "exercise": {
      "type": "object",
      "required": [
        "id", "trainer_id", "slug", "name", "short_description",
        "primary_skill", "secondary_skills", "training_area", "modes",
        "min_players", "max_players", "difficulty",
        "estimated_duration_seconds", "objective", "focus", "instructions",
        "rules", "progression_steps", "self_evaluation", "stimuli_sources",
        "requirements", "safety", "source", "status", "content_version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^ex-[a-z0-9-]+$" },
        "trainer_id": { "type": "string", "pattern": "^T(0[1-9]|10)$" },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "short_description": { "$ref": "#/$defs/nonEmptyString" },
        "primary_skill": { "$ref": "#/$defs/nonEmptyString" },
        "secondary_skills": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "training_area": {
          "enum": ["BODY", "MIND", "ACTOR", "IMPRO", "SCENE", "STORY", "GROUP"]
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["solo", "pair", "group"] }
        },
        "min_players": { "type": "integer", "minimum": 1 },
        "max_players": { "type": ["integer", "null"], "minimum": 1 },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
        "estimated_duration_seconds": { "type": "integer", "minimum": 60, "maximum": 900 },
        "objective": { "$ref": "#/$defs/nonEmptyString" },
        "focus": { "$ref": "#/$defs/nonEmptyString" },
        "instructions": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "rules": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "progression_steps": {
          "type": "array", "minItems": 3, "maxItems": 7,
          "items": { "$ref": "#/$defs/progressionStep" }
        },
        "self_evaluation": {
          "type": "array", "minItems": 2, "maxItems": 4,
          "items": { "$ref": "#/$defs/evaluationCriterion" }
        },
        "stimuli_sources": {
          "type": "array", "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "motor_policy": { "$ref": "#/$defs/motorPolicy" },
        "requirements": {
          "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "safety": {
          "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "source": { "$ref": "#/$defs/source" },
        "status": { "enum": ["draft", "validated", "published"] },
        "content_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
      }
    }
  }
}
